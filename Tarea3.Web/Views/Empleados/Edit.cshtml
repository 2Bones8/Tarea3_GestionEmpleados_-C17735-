@model Tarea3.MODEL.Empleado

<div class="container">
    <h2>Editar Empleado: @Model.NombreCompleto</h2>
    <hr />
    <form asp-action="Edit">
        <input type="hidden" asp-for="FechaIngreso" />
        <input type="hidden" asp-for="Id" />
        <!-- Las casillas ID y Fecha de Ingreso se mantienen ocultas para no ser editables y que no hayan errore -->
        
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Apellidos" class="form-label"></label>
                <input asp-for="Apellidos" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Departamento" class="form-label"></label>
            <input asp-for="Departamento" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Salario" class="form-label"></label>
            <input asp-for="Salario" type="number" class="form-control" />
        </div>

        <div class="mb-3 form-check">
            <input asp-for="Activo" class="form-check-input" type="checkbox" />
            <label class="form-check-label" asp-for="Activo">Empleado Activo</label>
        </div>

        <button type="submit" class="btn btn-success">Actualizar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>